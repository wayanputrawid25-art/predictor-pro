# ===========================================
# DATABASE - Neon PostgreSQL
# ===========================================
DATABASE_URL="postgresql://user:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/predictor_pro?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/predictor_pro?sslmode=require&pooled=false"

# ===========================================
# API-Football (Primary Data Source)
# ===========================================
API_FOOTBALL_KEY="your-api-football-api-key"
API_FOOTBALL_HOST="v3.football.api-sports.io"

# ===========================================
# The Odds API (Odds Data)
# ===========================================
ODDS_API_KEY="your-odds-api-key"
ODDS_API_HOST="api.the-odds-api.com"

# ===========================================
# OpenAI (AI Prediction Enhancement)
# ===========================================
OPENAI_API_KEY="sk-your-openai-api-key"

# ===========================================
# REDIS (Caching - Optional, for production)
# ===========================================
REDIS_URL="redis://default:password@your-redis-url.redis.cloud:6379"

# ===========================================
# NEXTAUTH / AUTH (For future user features)
# ===========================================
# AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL="http://localhost:3000"

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Predictor Pro"

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS="900000"      # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL="info"  # debug, info, warn, error

# ===========================================
# VERCEL (Auto-populated on Vercel)
# ===========================================
# VERCEL_URL=""
# VERCEL_GIT_COMMIT_SHA=""
# VERCEL_ENV="production"
